{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policeconduct.us/schemas/filing-overlay-manifest.schema.json",
  "title": "Filing-version overlay manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "filing_version_id": {
      "$ref": "#/$defs/stableId"
    },
    "artifact_id": {
      "$ref": "#/$defs/stableId"
    },
    "artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_snapshot": {
      "$ref": "#/$defs/snapshotReference"
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/overlayPin"
      }
    }
  },
  "required": [
    "schema_version",
    "filing_version_id",
    "artifact_id",
    "artifact_sha256",
    "source_snapshot",
    "overlays"
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "snapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checked_through": {
          "$ref": "#/$defs/date"
        }
      },
      "required": ["snapshot_id", "version", "sha256", "checked_through"]
    },
    "overlayPin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "litigation-alignment",
            "judge",
            "counsel-identity",
            "counsel-team"
          ]
        },
        "overlay_id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checked_through": {
          "$ref": "#/$defs/date"
        },
        "validator_result": {
          "enum": ["passed", "failed", "unavailable"]
        },
        "source_snapshot_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_snapshot_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "kind",
        "overlay_id",
        "version",
        "sha256",
        "checked_through",
        "validator_result",
        "source_snapshot_id",
        "source_snapshot_version",
        "source_snapshot_sha256"
      ]
    }
  }
}
