{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policeconduct.us/schemas/skill-folder-contract.schema.json",
  "title": "Skill folder contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "skill",
    "input_roles",
    "target",
    "internet",
    "output"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "input_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "optional_input_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "roles"],
      "properties": {
        "policy": { "enum": ["required", "optional", "none"] },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "internet": {
      "oneOf": [
        { "enum": ["disabled", "authorized"] },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": { "enum": ["disabled", "authorized"] }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "append-immutable" } }
    }
  }
}
