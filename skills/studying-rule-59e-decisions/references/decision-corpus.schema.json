{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policeconduct.us/schemas/rule59-decision-corpus-v1.json",
  "title": "Rule 59 decision corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study",
    "denominator",
    "decision_records",
    "retrieval_gaps",
    "transfer_cards"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "study": {
      "$ref": "#/$defs/study"
    },
    "denominator": {
      "$ref": "#/$defs/denominator"
    },
    "decision_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decisionRecord"
      }
    },
    "retrieval_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retrievalGap"
      }
    },
    "transfer_cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transferCard"
      }
    }
  },
  "$defs": {
    "nullablePerson": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "nonblankString": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonblankString"
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "version",
        "research_question",
        "governing_circuit",
        "district",
        "decisionmakers",
        "date_range",
        "included_motion_types",
        "case_categories",
        "excluded_categories",
        "databases_searched",
        "search_queries",
        "search_dates",
        "deduplication_method",
        "known_unavailable_sources",
        "denominator_definition"
      ],
      "properties": {
        "study_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "version": {
          "$ref": "#/$defs/nonblankString"
        },
        "research_question": {
          "$ref": "#/$defs/nonblankString"
        },
        "governing_circuit": {
          "$ref": "#/$defs/nonblankString"
        },
        "district": {
          "$ref": "#/$defs/nonblankString"
        },
        "decisionmakers": {
          "$ref": "#/$defs/stringArray"
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "$ref": "#/$defs/date"
            },
            "end": {
              "$ref": "#/$defs/date"
            }
          }
        },
        "included_motion_types": {
          "$ref": "#/$defs/stringArray"
        },
        "case_categories": {
          "$ref": "#/$defs/stringArray"
        },
        "excluded_categories": {
          "$ref": "#/$defs/stringArray"
        },
        "databases_searched": {
          "$ref": "#/$defs/stringArray"
        },
        "search_queries": {
          "$ref": "#/$defs/stringArray"
        },
        "search_dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        },
        "deduplication_method": {
          "$ref": "#/$defs/nonblankString"
        },
        "known_unavailable_sources": {
          "$ref": "#/$defs/stringArray"
        },
        "denominator_definition": {
          "$ref": "#/$defs/nonblankString"
        }
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defined_universe",
        "sampling_method",
        "candidate_count",
        "coded_pair_count",
        "research_question_complete_count",
        "unresolved_relevant_missingness",
        "completeness_status",
        "limits"
      ],
      "properties": {
        "defined_universe": {
          "$ref": "#/$defs/nonblankString"
        },
        "sampling_method": {
          "type": "string",
          "enum": ["attempted-census", "convenience"]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "coded_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "research_question_complete_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_relevant_missingness": {
          "type": "integer",
          "minimum": 0
        },
        "completeness_status": {
          "type": "string",
          "enum": ["complete", "incomplete"]
        },
        "limits": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "motion_id",
        "related_stage_ids",
        "case_name",
        "case_number",
        "court",
        "assigned_judge",
        "reasoning_author",
        "recommendation_author",
        "adopting_judge",
        "decision_type",
        "posture",
        "ground_children",
        "requested_relief",
        "proposed_material",
        "independent_reasoning",
        "disposition",
        "sources",
        "missing_documents",
        "appellate_history"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "motion_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "related_stage_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "case_name": {
          "$ref": "#/$defs/nonblankString"
        },
        "case_number": {
          "$ref": "#/$defs/nonblankString"
        },
        "court": {
          "$ref": "#/$defs/nonblankString"
        },
        "assigned_judge": {
          "$ref": "#/$defs/nonblankString"
        },
        "reasoning_author": {
          "$ref": "#/$defs/nullablePerson"
        },
        "recommendation_author": {
          "$ref": "#/$defs/nullablePerson"
        },
        "adopting_judge": {
          "$ref": "#/$defs/nullablePerson"
        },
        "decision_type": {
          "type": "string",
          "enum": [
            "recommendation",
            "adoption-only-order",
            "independently-reasoned-final-decision",
            "consent-final-decision",
            "outcome-only-order"
          ]
        },
        "posture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "challenged_disposition",
            "judgment_status",
            "rule_subsection",
            "motion_type",
            "case_category",
            "representation_status"
          ],
          "properties": {
            "challenged_disposition": {
              "$ref": "#/$defs/nonblankString"
            },
            "judgment_status": {
              "$ref": "#/$defs/nonblankString"
            },
            "rule_subsection": {
              "type": "string",
              "enum": ["59(a)", "59(e)", "59-unspecified"]
            },
            "motion_type": {
              "$ref": "#/$defs/nonblankString"
            },
            "case_category": {
              "$ref": "#/$defs/nonblankString"
            },
            "representation_status": {
              "type": "string",
              "enum": ["represented", "pro-se", "unknown"]
            }
          }
        },
        "ground_children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ground_id",
              "asserted_ground",
              "court_treatment",
              "ground_result",
              "supporting_pinpoint"
            ],
            "properties": {
              "ground_id": {
                "$ref": "#/$defs/nonblankString"
              },
              "asserted_ground": {
                "$ref": "#/$defs/nonblankString"
              },
              "court_treatment": {
                "$ref": "#/$defs/nonblankString"
              },
              "ground_result": {
                "$ref": "#/$defs/nonblankString"
              },
              "supporting_pinpoint": {
                "$ref": "#/$defs/nonblankString"
              }
            }
          }
        },
        "requested_relief": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonblankString"
          }
        },
        "proposed_material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "description"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete-attached",
                "complete-tendered-separately",
                "cure-explanation-only",
                "neither",
                "not-applicable",
                "unknown"
              ]
            },
            "description": {
              "$ref": "#/$defs/nonblankString"
            }
          }
        },
        "independent_reasoning": {
          "type": "string",
          "enum": [
            "independent",
            "adopts-with-additional-reasoning",
            "adopts-without-additional-reasoning",
            "recommendation-only",
            "docket-outcome-only",
            "unclear"
          ]
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "stated_reasons", "outcome_changing_reason"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "grant-full",
                "grant-partial",
                "correction-without-relief",
                "deny",
                "procedural-disposition",
                "administrative-only",
                "withdrawn",
                "unresolved"
              ]
            },
            "stated_reasons": {
              "$ref": "#/$defs/stringArray"
            },
            "outcome_changing_reason": {
              "$ref": "#/$defs/nonblankString"
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "source_type",
              "identity",
              "checked_date"
            ],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/nonblankString"
              },
              "source_type": {
                "$ref": "#/$defs/nonblankString"
              },
              "identity": {
                "$ref": "#/$defs/nonblankString"
              },
              "checked_date": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "missing_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gap_id", "document_type", "description"],
            "properties": {
              "gap_id": {
                "$ref": "#/$defs/nonblankString"
              },
              "document_type": {
                "$ref": "#/$defs/nonblankString"
              },
              "description": {
                "$ref": "#/$defs/nonblankString"
              }
            }
          }
        },
        "appellate_history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appeal_taken",
            "review_standard",
            "result",
            "checked_through"
          ],
          "properties": {
            "appeal_taken": {
              "type": "boolean"
            },
            "review_standard": {
              "$ref": "#/$defs/nonblankString"
            },
            "result": {
              "$ref": "#/$defs/nonblankString"
            },
            "checked_through": {
              "$ref": "#/$defs/date"
            }
          }
        }
      }
    },
    "retrievalGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "record_id",
        "document_type",
        "status",
        "retrieval_attempts",
        "limit"
      ],
      "properties": {
        "gap_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "record_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "document_type": {
          "$ref": "#/$defs/nonblankString"
        },
        "status": {
          "type": "string",
          "enum": ["unavailable", "unresolved", "not-found"]
        },
        "retrieval_attempts": {
          "$ref": "#/$defs/stringArray"
        },
        "limit": {
          "$ref": "#/$defs/nonblankString"
        }
      }
    },
    "transferCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "proposition",
        "universe",
        "numerator",
        "denominator",
        "date_range",
        "source_row_ids",
        "evidence_level",
        "missingness",
        "disconfirming_row_ids",
        "permitted_use",
        "prohibited_inference",
        "checked_through",
        "actual_source_identity",
        "source_checked_date",
        "metric_type"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "proposition": {
          "type": "string",
          "minLength": 1
        },
        "universe": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "date_range": {
          "type": "string",
          "minLength": 1
        },
        "source_row_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_level": {
          "type": "string",
          "enum": ["example", "documented-cluster", "tendency"]
        },
        "missingness": {
          "type": "string",
          "minLength": 1
        },
        "disconfirming_row_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permitted_use": {
          "type": "string",
          "minLength": 1
        },
        "prohibited_inference": {
          "type": "string",
          "minLength": 1
        },
        "checked_through": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "actual_source_identity": {
          "type": "string",
          "minLength": 1
        },
        "source_checked_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "metric_type": {
          "type": "string",
          "enum": ["descriptive", "success-rate"]
        }
      }
    }
  }
}
