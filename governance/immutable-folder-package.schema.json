{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policeconduct.us/schemas/immutable-folder-package.schema.json",
  "title": "Immutable folder package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_kind",
    "package_id",
    "created_at",
    "freshness",
    "producer",
    "sources",
    "members",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": 1, "type": "integer" },
    "package_kind": { "$ref": "#/$defs/identifier" },
    "package_id": { "$ref": "#/$defs/identifier" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "producer": { "$ref": "#/$defs/producer" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "format": "date" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_through", "retrieved_on"],
      "properties": {
        "checked_through": {
          "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
        },
        "retrieved_on": {
          "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "operation", "run_id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/identifier" },
        "run_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source_id", "fingerprint"],
      "properties": {
        "role": { "$ref": "#/$defs/identifier" },
        "source_id": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "classification",
        "path",
        "media_type",
        "size",
        "sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "role": { "$ref": "#/$defs/identifier" },
        "classification": {
          "enum": [
            "profile",
            "overlay",
            "corpus",
            "source",
            "provenance",
            "classification",
            "assumptions",
            "gaps",
            "validation-receipt",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!package-manifest\\.json$)(?!/)(?![\\s\\S]*\\\\)(?![\\s\\S]*\\u0000)(?!\\.{1,2}(?:/|$))(?![\\s\\S]*/\\.{1,2}(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$)[\\s\\S]+$"
        },
        "media_type": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator",
        "version",
        "validated_at",
        "receipt_member_id"
      ],
      "properties": {
        "status": { "const": "passed" },
        "validator": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "validated_at": { "$ref": "#/$defs/timestamp" },
        "receipt_member_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
