{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policeconduct.us/schemas/static-role-contract.schema.json",
  "title": "Protected static role contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role_kind",
    "accepted_profile_kinds",
    "freshness_policy",
    "capabilities",
    "prohibitions",
    "internet",
    "target_mutation",
    "output"
  ],
  "properties": {
    "schema_version": { "const": 1, "type": "integer" },
    "role_kind": { "$ref": "#/$defs/identifier" },
    "accepted_profile_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "max_age_days"],
      "properties": {
        "basis": { "enum": ["checked_through", "retrieved_on"] },
        "max_age_days": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "internet": { "enum": ["disabled", "enabled"] },
    "target_mutation": { "const": "forbidden" },
    "output": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
