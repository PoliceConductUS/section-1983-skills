{
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "test:unit": "python3 -m unittest discover -s skills/section-1983-drafting/scripts -p \"test_*.py\"",
    "skills:list": "npx skills add . --list",
    "openspec:status": "openspec status",
    "openspec:validate": "openspec validate --all",
    "validate": "npm run format:check && npm run test:unit && npm run skills:list && npm run openspec:validate"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.3.1",
    "prettier": "3.8.3"
  }
}
