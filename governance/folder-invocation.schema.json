{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policeconduct.us/schemas/folder-invocation.schema.json",
  "title": "Folder-Scoped Skill Invocation",
  "description": "Version 1 envelope for a trusted host to declare folder-scoped skill execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "skill",
    "inputs",
    "output",
    "runtime",
    "internet",
    "isolation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "skill": {
      "$ref": "#/$defs/identifier"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "internet": {
      "enum": ["disabled", "authorized"]
    },
    "isolation": {
      "$ref": "#/$defs/isolation"
    },
    "target": {
      "$ref": "#/$defs/target"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/.*|[A-Za-z]:[\\\\/].*)$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.?$)(?!.*(?:^|/)\\.\\.?/)[^\\u0000\\\\/]+(?:/[^\\u0000\\\\/]+)*$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "root"],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_seconds", "max_input_bytes"],
      "properties": {
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "output", "undeclared"],
      "properties": {
        "inputs": {
          "const": "read-only"
        },
        "output": {
          "const": "read-write"
        },
        "undeclared": {
          "const": "none"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
